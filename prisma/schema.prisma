// Dashboard data: the people who sign in, and the two kinds of content they
// create. Everything the public site rendered before this file still lives in
// `app/lib/*.ts`; these collections are merged on top of it at read time, so
// the site keeps working with an empty database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// What a signed-in person is allowed to do.
///
/// SUPERADMIN is the only role that can reach /admin/users, and the only one
/// that can create or disable an account. There is exactly one of it, seeded
/// from SUPERADMIN_PASSWORD under the fixed username `superadmin` — see
/// `app/lib/auth/superadmin.ts`.
enum Role {
  SUPERADMIN
  EDITOR
  LISTER
}

/// Draft until someone publishes it. Only PUBLISHED rows reach the public site.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  /// The sign-in handle. Lowercased on write so `Sara` and `sara` are one account.
  username     String    @unique
  name         String
  email        String?
  /// bcrypt. Never selected into anything that crosses to the client.
  passwordHash String
  role         Role
  /// Disabling beats deleting: an article keeps its author, and the sign-in
  /// is refused all the same.
  active       Boolean   @default(true)
  /// Set when a superadmin creates the account, cleared once the person picks
  /// their own password.
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdById  String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles   Article[]
  properties Property[]

  // Auth.js adapter tables. Unused while Credentials is the only provider,
  // and present so adding an OAuth provider later is a config change.
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Article {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  /// Also the URL: /<lang>/knowledge/<slug>. Unique across the database, and
  /// checked against the static articles too — see `reservedSlugs`.
  slug      String        @unique
  title     String
  /// The standfirst. Shown on cards and used as the meta description.
  excerpt   String
  /// One entry per paragraph. A leading `## ` marks a heading, matching the
  /// convention `ArticleBody` already renders for the migrated pieces.
  body      String[]
  /// Keys from `app/lib/topics.ts`. Validated on write.
  topics    String[]
  /// "Press Media" for coverage elsewhere, "Blog" for our own writing.
  category  String        @default("Blog")
  /// The publication a press piece ran in. Absent on our own writing.
  source    String?
  /// Card thumbnail, ~3:2.
  image     String?
  /// Wide banner for the article page, ~8:3. Falls back to `image`.
  hero      String?
  /// Where "Read More" points. The button is omitted without it.
  readMore  String?
  /// Overrides the `<title>`. A headline is written for the page and a title
  /// tag is written for a result listing; they are usually not one sentence.
  seoTitle       String?
  /// Overrides the meta description. The standfirst is used when it is absent.
  seoDescription String?
  /// Points search engines at the original, for a piece that also ran
  /// elsewhere. Absent on our own writing, which is its own canonical.
  canonicalUrl   String?
  /// Keeps the piece out of search results while leaving the URL readable —
  /// for a page that exists to be linked from a campaign, not found.
  noindex        Boolean @default(false)
  status    ContentStatus @default(DRAFT)
  /// When the piece is filed, which is what the index sorts on. Set at first
  /// publish and editable afterwards, because a backdated import needs its
  /// real date — and because a future date is how a piece is scheduled: it is
  /// PUBLISHED in the dashboard and withheld from the site until the moment
  /// arrives. See `cmsArticles`.
  publishedAt DateTime?
  authorId  String        @db.ObjectId
  author    User          @relation(fields: [authorId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

/// One of the short cards on a listing's page. Embedded rather than a table:
/// a highlight has no life of its own away from the listing it is on.
type PropertyHighlight {
  title String
  text  String
}

model Property {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  slug         String        @unique
  /// A development name plus its layout — "Marmara Vista 2 Bedroom".
  title        String
  /// The development this unit sits in.
  project      String
  /// Place names, resolved through `dictionary.places` on the public site.
  location     String
  country      String
  /// One column per currency rather than an embedded document, so the search
  /// page can filter on a price ceiling without loading every unit.
  priceUSD     Int
  priceEUR     Int
  priceTRY     Int
  /// "Apartment" | "Townhouse" | "Villa", matching `propertyTypes`.
  type         String
  bathrooms    String
  bedroom      String
  size         String
  level        String
  view         String
  soldOut      Boolean       @default(false)
  /// Derived from the Türkiye CBI threshold on write, and overridable — a
  /// Caribbean unit qualifies under a different programme entirely.
  cbiEligible  Boolean       @default(false)
  /// Card and hero image.
  image        String
  /// Additional photography for the listing, in order.
  gallery      String[]

  // --- The listing's own page ------------------------------------------------
  // Everything below is optional: a lister can put a unit on the search page
  // with the fields above alone, and each of these adds a section to
  // /properties/<slug> rather than being required to have one at all.

  /// The prose under the hero. Absent, the page leads with the specs.
  description   String?
  /// Three or so short cards — what somebody should know before scrolling.
  highlights    PropertyHighlight[]
  /// Amenity names. Translated through `dictionary.property.amenityItems`
  /// where the name is one the site already knows, and shown as written
  /// otherwise.
  amenities     String[]
  /// The brochure emailed by "Download Brochure". A Cloudinary URL, or a path
  /// under /public. Absent, the button is not shown.
  brochure      String?
  /// Floor plans, in the order they should be read.
  floorPlans    String[]

  // --- Commercials -----------------------------------------------------------

  /// "30% on signing, 70% over 24 months", as the developer words it.
  paymentPlan   String?
  /// When the unit is handed over — "Q4 2027", or "Ready to move in".
  handover      String?
  /// Annual service charge, as written.
  serviceCharge String?
  /// Title deed status — "Ready title deed", "Under construction (kat irtifakı)".
  titleDeed     String?
  /// Whether the unit is held through a Turkish REIT (gayrimenkul yatırım
  /// ortaklığı). Nullable rather than a default: "not stated" and "no" are
  /// different answers to a buyer, and only one of them belongs on the page.
  gyo              Boolean?
  /// VAT charged on the purchase, as a whole percentage — 0, 1, 10 or 20.
  vatRate          Int?
  /// Title deed transfer tax, as a whole percentage — 0, 2 or 4.
  titleDeedTaxRate Int?

  // --- The page's own metadata ----------------------------------------------

  /// A tour, on YouTube or Vimeo. Rendered as a link, never an autoplaying embed.
  videoUrl      String?
  /// Where the map pin goes. Both or neither; the map is omitted without them.
  mapLat        Float?
  mapLng        Float?
  /// Overrides the <title>. A headline and a title tag are rarely one sentence.
  seoTitle       String?
  /// Overrides the meta description. The description is used when absent.
  seoDescription String?
  /// Keeps the listing out of search results while leaving the URL readable.
  noindex        Boolean @default(false)

  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  listerId     String        @db.ObjectId
  lister       User          @relation(fields: [listerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, country])
  @@map("properties")
}

// --- Auth.js adapter models --------------------------------------------------
// Shapes fixed by @auth/prisma-adapter; do not rename their fields.

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Event visitors (app/lib/events) ----------------------------------------
// The people who booked a slot at a trade show, and every reminder sent to
// them. Imported from the sales team's spreadsheet rather than typed in, so
// the import has to be safely repeatable — hence `dedupeKey`.

/// Which half of the day someone asked for.
///
/// The spreadsheet says "Morning", "Afternoon", "1800 hrs", "3PM" and "7 or 8
/// Sep" in the same column, so the raw text is kept alongside this and the
/// slot is what the reminder schedule is computed from. UNSPECIFIED is not a
/// failure — it means nobody has pinned the visitor down yet, and it is the
/// filter the team works through on the morning of the show.
enum VisitSlot {
  MORNING
  AFTERNOON
  EVENING
  UNSPECIFIED
}

/// Where a booking stands. The first two mirror the spreadsheet's Remarks
/// column ("Confirmed" / "Response awaited"); the rest are filled in at the
/// stand as people arrive, which is what makes the report worth reading after
/// the show as well as during it.
enum VisitorStatus {
  AWAITING
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  SENT
  FAILED
}

model EventVisitor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  /// Which show. One key per event so next year's list does not have to live
  /// in a second collection.
  event  String @default("ips-2026")
  /// The spreadsheet tab: "Visitors" or "Clients". Kept because the two are
  /// reported on separately — a client already has a relationship, a visitor
  /// is a lead.
  list   String @default("Visitors")
  /// The row number in the sheet it came from, for reconciling by eye.
  serial Int?

  name  String
  email String?
  /// E.164 without the plus, which is what `wa.me` wants and what the sheet
  /// holds once Excel's scientific notation is undone.
  phone String?

  /// Midnight UTC on the day of the visit, or absent when the sheet says
  /// something like "7 or 8 Sep".
  visitDate    DateTime?
  /// Exactly what the sheet said, so a person can always see the original.
  visitDateRaw String    @default("")
  slot         VisitSlot @default(UNSPECIFIED)
  preferredTimeRaw String @default("")

  /// When the reminder is due — derived from the visit date and slot on
  /// import, and editable afterwards for the one visitor who wants it later.
  /// Absent means the schedule could not be worked out; that visitor is
  /// reported as needing a decision rather than quietly never contacted.
  remindAt DateTime?

  status VisitorStatus @default(AWAITING)
  notes  String?

  /// Denormalised from the reminder log so the list can be sorted and
  /// filtered on "not yet contacted" without a join per row.
  emailSentAt    DateTime?
  whatsappSentAt DateTime?

  /// `event:email` — or the phone, or the name — so re-importing the same
  /// spreadsheet updates rows instead of doubling them.
  dedupeKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders EventReminder[]

  @@index([event, remindAt])
  @@index([event, visitDate, slot])
  @@map("event_visitors")
}

/// One send attempt, kept whether it worked or not.
///
/// A failure is the row worth having: "we emailed everybody" is only true if
/// nothing in here says otherwise, and the report leads with the failures for
/// that reason.
model EventReminder {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  visitorId String          @db.ObjectId
  visitor   EventVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  channel   ReminderChannel
  status    ReminderStatus
  subject   String?
  /// The provider's message id on success, the error on failure.
  detail    String?
  /// Who pressed the button. Absent when the scheduled run sent it.
  sentById  String?         @db.ObjectId
  sentByName String?
  automatic Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@map("event_reminders")
}
