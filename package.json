{
  "name": "multimulk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "check:i18n": "node scripts/i18n-coverage.mjs --check",
    "check:figures": "node scripts/check-figures.mjs",
    "check:review": "node scripts/check-review.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run check:figures && npm run check:tables && npm run check:review && npm run check:redirects",
    "check:redirects": "node scripts/check-redirects.mjs --check",
    "check:bitrix": "node --env-file=.env.local scripts/check-bitrix.mjs",
    "check:tables": "node scripts/check-tables.mjs",
    "db:generate": "prisma generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:studio": "node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@next/third-parties": "^16.3.4",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
